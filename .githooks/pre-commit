#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

log() {
  printf '%s\n' "$*"
}

require_command() {
  command_name="$1"
  install_hint="$2"

  if command -v "$command_name" >/dev/null 2>&1; then
    return 0
  fi

  log "Missing required command: $command_name"
  log "$install_hint"
  exit 1
}

staged_files() {
  git diff --cached --name-only --diff-filter=ACMR
}

formatted_files="$(mktemp "${TMPDIR:-/tmp}/chezmoi-pre-commit.XXXXXX")"
trap 'rm -f "$formatted_files"' EXIT HUP INT TERM

format_staged_files() {
  staged_files | while IFS= read -r file; do
    case "$file" in
    *.fish)
      if [ -f "$file" ]; then
        require_command fish_indent "Install fish with: brew install fish"
        before="$(cksum <"$file")"
        fish_indent --write "$file"
        after="$(cksum <"$file")"
      else
        continue
      fi
      ;;
    *.sh | .githooks/*)
      if [ -f "$file" ]; then
        require_command shfmt "Install shfmt with: brew install shfmt"
        before="$(cksum <"$file")"
        shfmt -i 2 -w "$file"
        after="$(cksum <"$file")"
      else
        continue
      fi
      ;;
    *)
      continue
      ;;
    esac

    if [ "$before" != "$after" ]; then
      printf '%s\n' "$file" >>"$formatted_files"
    fi
  done
}

fail_if_format_changed_files() {
  if [ -s "$formatted_files" ]; then
    log "Formatting changed staged files. Review and stage them, then commit again:"
    cat "$formatted_files"
    exit 1
  fi
}

require_command gitleaks "Install gitleaks with: brew install gitleaks"
gitleaks protect --staged --redact

format_staged_files
fail_if_format_changed_files
