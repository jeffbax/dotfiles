#!/bin/sh
set -eu

os="{{ .chezmoi.os }}"

if [ "$os" != "darwin" ]; then
  printf '%s\n' "Skipping macOS defaults on unsupported OS: $os"
  exit 0
fi

write_default() {
  domain="$1"
  key="$2"
  type="$3"
  value="$4"

  printf 'Setting %s %s = %s\n' "$domain" "$key" "$value"
  defaults write "$domain" "$key" "-$type" "$value"
}

delete_default_if_exists() {
  domain="$1"
  key="$2"

  if defaults read "$domain" "$key" >/dev/null 2>&1; then
    printf 'Deleting %s %s\n' "$domain" "$key"
    defaults delete "$domain" "$key"
  fi
}

# Auto appearance; deleting AppleInterfaceStyle clears a forced light/dark mode.
write_default NSGlobalDomain AppleInterfaceStyleSwitchesAutomatically bool true

# Scrollbar paging behavior: true jumps to the clicked spot in the scroll track.
write_default NSGlobalDomain AppleScrollerPagingBehavior bool true
write_default NSGlobalDomain AppleShowScrollBars string Always
delete_default_if_exists NSGlobalDomain AppleInterfaceStyle

write_default NSGlobalDomain AppleShowAllExtensions bool false

# Title bar double-click behavior: Fill, not minimize.
write_default NSGlobalDomain AppleActionOnDoubleClick string Fill
write_default NSGlobalDomain AppleMiniaturizeOnDoubleClick bool false

write_default com.apple.dock autohide bool true
write_default com.apple.dock expose-group-apps bool true
write_default com.apple.dock mineffect string scale
write_default com.apple.dock orientation string bottom
write_default com.apple.dock showAppExposeGestureEnabled bool true
write_default com.apple.dock showMissionControlGestureEnabled bool true

# Hot corner codes: 3 = Application Windows, 4 = Desktop,
# 5 = Start Screen Saver, 14 = Quick Note. Modifier 0 = no modifier key.
write_default com.apple.dock wvous-bl-corner int 3
write_default com.apple.dock wvous-bl-modifier int 0
write_default com.apple.dock wvous-br-corner int 4
write_default com.apple.dock wvous-br-modifier int 0
write_default com.apple.dock wvous-tl-corner int 5
write_default com.apple.dock wvous-tl-modifier int 0
write_default com.apple.dock wvous-tr-corner int 14
write_default com.apple.dock wvous-tr-modifier int 0

# Trackpad code: 2 = four-finger vertical swipes for Mission Control/App Expose.
write_default com.apple.AppleMultitouchTrackpad TrackpadFourFingerVertSwipeGesture int 2
write_default com.apple.driver.AppleBluetoothMultitouch.trackpad TrackpadFourFingerVertSwipeGesture int 2

write_default com.apple.finder FinderSpawnTab bool false
write_default com.apple.finder FXArrangeGroupViewBy string Name

# Finder codes: SCcf = search current folder, clmv = column view.
write_default com.apple.finder FXDefaultSearchScope string SCcf
write_default com.apple.finder FXPreferredGroupBy string Kind
write_default com.apple.finder FXPreferredViewStyle string clmv

# Show the POSIX path in Finder window titles.
write_default com.apple.finder FXShowPosixPathInTitle bool true

# Finder codes: PfHm = home folder; target path must be a file URL.
write_default com.apple.finder NewWindowTarget string PfHm
write_default com.apple.finder NewWindowTargetPath string "file://$HOME/"
# Set the Finder prefs for showing a few different volumes on the Desktop.
write_default com.apple.finder ShowExternalHardDrivesOnDesktop bool true
write_default com.apple.finder ShowPathbar bool true
write_default com.apple.finder ShowStatusBar bool true

# Use AirDrop over every interface. srsly this should be a default.
defaults write com.apple.NetworkBrowser BrowseAllInterfaces 1

printf '%s\n' "Showing $HOME/Library in Finder"
chflags nohidden "$HOME/Library"

write_default com.apple.Safari AlwaysRestoreSessionAtLaunch bool true
write_default com.apple.Safari AutoFillCreditCardData bool false
write_default com.apple.Safari AutoFillFromAddressBook bool false
write_default com.apple.Safari AutoFillPasswordsInSafari bool false
write_default com.apple.Safari AutoOpenSafeDownloads bool false
write_default com.apple.Safari IncludeDevelopMenu bool true
write_default com.apple.Safari PrivateSearchEngineUsesNormalSearchEngineToggle bool false
write_default com.apple.Safari PrivateSearchProviderShortName string DuckDuckGo
write_default com.apple.Safari SearchProviderShortName string Google
write_default com.apple.Safari ShowFullURLInSmartSearchField bool true
write_default com.apple.Safari.plist ShowFavoritesBar bool false
write_default com.apple.Safari ShowOverlayStatusBar bool true

# WBS keys record the explicit search engine choices in newer Safari versions.
write_default com.apple.Safari WBSLastPrivateSearchEngineStringExplicitlyChosenByUserKey string com.duckduckgo
write_default com.apple.Safari WBSLastSearchEngineStringExplicitlyChosenByUserKey string com.google

# Cover both Safari's preference key and WebKit's developer extras switch.
write_default com.apple.Safari WebKitDeveloperExtrasEnabledPreferenceKey bool true
write_default com.apple.Safari com.apple.Safari.ContentPageGroupIdentifier.WebKit2DeveloperExtrasEnabled bool true
write_default NSGlobalDomain WebKitDeveloperExtras bool true

write_default com.panic.Nova DefaultSyntaxMode string plain-text
write_default com.panic.Nova TabWidth int 2
write_default com.panic.Nova IndentationStyle int 0
write_default com.panic.Nova EditorConfigEnabled bool true
write_default com.panic.Nova IndentationStyleShouldAutodetect bool true
write_default com.panic.Nova ShowIndentationGuides bool true
write_default com.panic.Nova IndentNewLines bool true
write_default com.panic.Nova AdjustIndentationWhileTyping bool true
write_default com.panic.Nova ReformatInsertedText bool true
write_default com.panic.Nova EnsureTrailingNewline bool true
write_default com.panic.Nova TrimTrailingWhitespace bool true
write_default com.panic.Nova TrimTrailingWhitespaceInEmptyLines bool true
