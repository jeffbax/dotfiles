if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv zsh)"
fi

case "$-" in
*i*) ;;
*)
  # Homebrew shellenv runs after .zshenv in login shells, so re-apply mise.
  if [ -r "$HOME/.config/zsh/chezmoi/mise.zsh" ]; then
    . "$HOME/.config/zsh/chezmoi/mise.zsh"
  fi
  ;;
esac
